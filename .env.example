# F2 settings for the live tests in tests/live. Copy to .env and fill in.
# Load into the shell before running the tests:
#   set -a; . ./.env; set +a
#   uv run python -m unittest tests.live.test_live_read -v
F2_SERVICE_INDEX_URL=
F2_CLIENT_ID=
F2_CLIENT_SECRET=
F2_USERNAME=
F2_PASSWORD=
F2_ORGANIZATION_PARTYNO=
F2_TIMEOUT=60

# ID of an existing case the live tests may read (never changed).
F2_LIVE_CASE_ID=
