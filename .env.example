# F2 settings for the live tests in tests/live. Copy to .env and fill in.
# Load into the shell before running the tests:
#   set -a; . ./.env; set +a
#   uv run python -m unittest tests.live.test_live_read -v
F2_SERVICE_INDEX_URL=
F2_CLIENT_ID=
F2_CLIENT_SECRET=
F2_USERNAME=
F2_PASSWORD=
F2_ORGANIZATION_PARTYNO=
F2_TIMEOUT=60

# Data the live tests may read (nothing is changed in F2).
# ID of an existing case.
F2_LIVE_CASE_ID=
# CPR number of a test citizen who has at least one case and a party in F2.
F2_LIVE_CPR=
# Login (initials) of an F2 user.
F2_LIVE_LOGIN=
# Set to 1 to run tests/live/test_live_create.py, which CREATES cases, matters
# and documents. Only for a test installation; nothing is deleted afterwards.
F2_LIVE_WRITE=
# Optional KLE number and handlingsfacet for the case created by the write test,
# e.g. 00.07.00 and G01. Must exist in the installation.
F2_LIVE_KLE=
F2_LIVE_FACET=
# Text for the full text searches, e.g. one that matches more than 100 cases.
F2_LIVE_SEARCH_TEXT=
